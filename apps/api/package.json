{
  "name": "@dealers-concierge/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target node --external @prisma/client",
    "start": "bun run dist/server.js",
    "test": "bun test",
    "lint": "eslint src --ext .ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "bun src/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@pothos/core": "^3.25.0",
    "@pothos/plugin-prisma": "^3.25.0",
    "bullmq": "^4.15.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "graphql": "^16.8.1",
    "graphql-yoga": "^5.0.0",
    "ioredis": "^5.3.2",
    "prisma": "^5.7.1",
    "@prisma/client": "^5.7.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  }
}
